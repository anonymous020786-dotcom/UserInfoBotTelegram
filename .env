# ============================================================
# SENTINEL TELEGRAM OSINT & DISCOVERY BOT - CONFIGURATION
# ============================================================

# 1. Telegram Bot Token from @BotFather (REQUIRED)
# Replace with your actual token from https://t.me/BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Administrator Telegram User IDs (comma-separated, e.g. 123456789,987654321)
ADMIN_IDS=123456789

# 3. Optional MTProto (Telethon) Credentials for Deep Global Search & Direct Inspection
# Get these from https://my.telegram.org -> API development tools
API_ID=
API_HASH=
SESSION_STRING=

# 4. Bot Rate Limiting Delay (in seconds between requests per user)
RATE_LIMIT_DELAY=1.0

# 5. Support & Repository URLs
SUPPORT_URL=https://t.me/Telegram
